# Use the UID/GID of your current File Browser process, as shown by `id` in it.
FILEBROWSER_UID=1000
FILEBROWSER_GID=1000
# Bind to your NAS LAN address for LAN access, or loopback behind a local proxy.
FILEBROWSER_BIND=127.0.0.1
FILEBROWSER_PORT=8080
# Existing absolute directories. The database directory must contain filebrowser.db.
FILEBROWSER_FILES=/path/on/nas/files
FILEBROWSER_DATABASE_DIR=/path/on/nas/filebrowser-database
